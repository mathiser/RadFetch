# Copy to .env and adjust. Every setting in src/radfetch/config.py can be set as RADFETCH_<NAME>.

# Absolute path of ./data on the Docker host. Required: the executor starts flow
# containers through the host's Docker daemon, which needs host paths for mounts.
RADFETCH_HOST_DATA_DIR=/srv/radfetch/data

# PACS
RADFETCH_PACS_HOST=fake-pacs
RADFETCH_PACS_PORT=11112
RADFETCH_PACS_AE_TITLE=PACS
RADFETCH_LOCAL_AE_TITLE=RADFETCH
# get: C-GET on one association. move: C-MOVE to our own storage SCP on port 11113;
# the PACS must then know RADFETCH_LOCAL_AE_TITLE as a destination at this host:11113.
RADFETCH_RETRIEVE_MODE=get
# dicomweb: QIDO-RS and WADO-RS instead of DIMSE
# RADFETCH_RETRIEVE_MODE=dicomweb
# RADFETCH_DICOMWEB_URL=https://pacs.example/dicom-web
# RADFETCH_DICOMWEB_TOKEN=

# PACS protection
RADFETCH_RATE_INSTANCES_PER_MIN=600
RADFETCH_BATCH_WINDOWS=mon-fri 18:00-06:00; sat-sun 00:00-24:00
RADFETCH_MAX_STAGED_JOBS=4
RADFETCH_MAX_RESOLVED_AHEAD=10

# Local timezone, used for the batch windows
TZ=Europe/Copenhagen

# API: require "Authorization: Bearer <token>" on everything except /healthz
# RADFETCH_API_TOKEN=change-me

# Push ingress: a pushed study is processed after this many quiet seconds
RADFETCH_SCP_STABLE_S=30
# Only these calling AE titles may push (comma-separated). Empty accepts any sender.
# RADFETCH_SCP_ALLOWED_AE_TITLES=CT_ROOM1,CT_ROOM2
