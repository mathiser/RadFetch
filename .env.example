# Copy to .env and adjust. Every setting in src/radfetch/config.py can be set as RADFETCH_<NAME>.

# Absolute path of ./data on the Docker host. Required: the executor starts flow
# containers through the host's Docker daemon, which needs host paths for mounts.
RADFETCH_HOST_DATA_DIR=/srv/radfetch/data

# PACS
RADFETCH_PACS_HOST=fake-pacs
RADFETCH_PACS_PORT=11112
RADFETCH_PACS_AE_TITLE=PACS
RADFETCH_LOCAL_AE_TITLE=RADFETCH
# get: C-GET on one association. move: C-MOVE to our own storage SCP on port 11113;
# the PACS must then know RADFETCH_LOCAL_AE_TITLE as a destination at this host:11113.
RADFETCH_RETRIEVE_MODE=get
# dicomweb: QIDO-RS and WADO-RS instead of DIMSE
# RADFETCH_RETRIEVE_MODE=dicomweb
# RADFETCH_DICOMWEB_URL=https://pacs.example/dicom-web
# RADFETCH_DICOMWEB_TOKEN=

# PACS protection
RADFETCH_RATE_INSTANCES_PER_MIN=600
RADFETCH_BATCH_WINDOWS=mon-fri 18:00-06:00; sat-sun 00:00-24:00
RADFETCH_MAX_STAGED_JOBS=4
RADFETCH_MAX_RESOLVED_AHEAD=10

# Local timezone, used for the batch windows
TZ=Europe/Copenhagen

# Accounts: create the first administrator with `radfetch user create <name> --role admin`.
# Address people use for the web interface (needed for single sign-on and secure cookies)
# RADFETCH_PUBLIC_URL=https://radfetch.example
# Make an authenticator app mandatory for password accounts
# RADFETCH_REQUIRE_MFA=true
# Single sign-on (OpenID Connect); see docs/sso.md
# RADFETCH_OIDC_ISSUER=https://login.example/realms/hospital
# RADFETCH_OIDC_CLIENT_ID=radfetch
# RADFETCH_OIDC_CLIENT_SECRET=
# RADFETCH_OIDC_ROLE_MAP={"radfetch-admins": "admin", "radiology": "viewer"}
# Optionally also accept one shared operator token:
# RADFETCH_API_TOKEN=change-me

# TLS for DICOM connections (PEM files, mounted into the gateway, scp and sender services)
# RADFETCH_TLS_CA_FILE=/certs/ca.pem
# RADFETCH_TLS_CERT_FILE=/certs/radfetch.pem
# RADFETCH_TLS_KEY_FILE=/certs/radfetch.key
# RADFETCH_PACS_TLS=true
# RADFETCH_SCP_TLS=true

# Push ingress: a pushed study is processed after this many quiet seconds
RADFETCH_SCP_STABLE_S=30
# Only these calling AE titles may push (comma-separated). Empty accepts any sender.
# RADFETCH_SCP_ALLOWED_AE_TITLES=CT_ROOM1,CT_ROOM2

# Keep the cached input and run files of failed jobs this many hours, so a retry does
# not fetch from the PACS again. 0 turns it off; disk pressure still evicts.
# RADFETCH_KEEP_FAILED_HOURS=168

# GPUs for this executor: empty for all, or ids such as 0 or 0,1
# RADFETCH_GPU_DEVICE_IDS=0
# Debug only, never in production: run gpu flows without a GPU (container gets RADFETCH_FAKE_GPU=1)
# RADFETCH_DEBUG_FAKE_GPU=true

# Notifications: POST a JSON message when a one-off job fails, a batch finishes or the PACS is unreachable
# RADFETCH_NOTIFY_WEBHOOK_URL=https://hooks.example/...
# Only if the receiving system is approved for patient-related data:
# RADFETCH_NOTIFY_INCLUDE_IDENTIFIERS=true
